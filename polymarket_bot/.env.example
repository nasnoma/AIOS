# ─────────────────────────────────────────────────────────────────
# Polymarket Bot — Environment Variables
# Copy to .env and fill in your values.
# This file is STANDALONE — no relation to trading_engine/.env
# ─────────────────────────────────────────────────────────────────

# ── Polymarket / Polygon Wallet ────────────────────────────────
# Your Polygon EOA private key (MetaMask export).
# If you signed up via email/Magic Link, also set POLYMARKET_FUNDER.
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_FUNDER=                  # Leave blank for MetaMask/EOA wallets
POLYMARKET_SIGNATURE_TYPE=0         # 0=EOA/MetaMask  1=Magic Link/Proxy

# ── LLM (OpenRouter) ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=google/gemini-flash-1.5   # Fast, cheap model for advisory tasks
LLM_ADVISOR_INTERVAL_CYCLES=20      # Run LLM every N completed windows

# ── Alerts (Telegram) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading Mode ───────────────────────────────────────────────
TRADING_MODE=paper                  # paper | live
ACCOUNT_SIZE=1000.0                 # Virtual USD for paper mode

# ── Target Markets ─────────────────────────────────────────────
TARGET_ASSETS=BTC,ETH               # Comma-separated: BTC | ETH | SOL

# ── Risk Controls ──────────────────────────────────────────────
MAX_RISK_PER_TRADE_PCT=0.01         # 1% of bankroll per trade max
MAX_CONCURRENT_POSITIONS=3          # Max open positions at one time
MAX_DAILY_LOSS_USD=100.0            # Circuit breaker: halt after $100 loss/day

# ── Strategy Parameters ────────────────────────────────────────
SPREAD_ARB_THRESHOLD=0.98           # Buy both legs if YES+NO sum < this
MOMENTUM_THRESHOLD_USD=15.0         # Min BTC $ move in 30s to trigger signal
MIN_CONFIDENCE=0.70                 # Min implied prob on favoured side (0–1)
MAX_ENTRY_PRICE=0.95                # Don't buy shares above 95¢
ENTRY_WINDOW_MIN_S=45               # Don't enter before 45s into a 5-min window
ENTRY_WINDOW_MAX_S=270              # Don't enter after 270s into a 5-min window
MOMENTUM_LOOKBACK_S=30              # BTC price lookback window for momentum calc

# ── Auto-Tune (LLM Recommendations) ───────────────────────────
LLM_AUTO_TUNE=false                 # If true, auto-apply LLM recommendations
