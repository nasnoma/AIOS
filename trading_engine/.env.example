# ─────────────────────────────────────────────
# TRADING ENGINE — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# ── LLM Provider (choose one) ──────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o             # gpt-4o | claude-3-5-sonnet-20241022

# ── Market Data ────────────────────────────
POLYGON_API_KEY=...           # stocks OHLCV + news (polygon.io)
BINANCE_API_KEY=...           # crypto (can be blank for public endpoints)
BINANCE_API_SECRET=...

# ── Stock Broker (Alpaca — paper trading) ──
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper | live

# ── Crypto Broker ──────────────────────────
CRYPTO_EXCHANGE=binance       # binance | bybit | coinbase
CRYPTO_TESTNET=true           # true = testnet, false = live

# ── Telegram Alerts ────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Database ───────────────────────────────
DATABASE_URL=postgresql://trader:secret@localhost:5432/trading_engine

# ── Trading Parameters ─────────────────────
TRADING_MODE=paper            # paper | live | signal_only
DEFAULT_ASSETS=BTC/USDT,ETH/USDT      # crypto watchlist
DEFAULT_STOCK_ASSETS=AAPL,TSLA,NVDA   # stock watchlist
TIMEFRAME=4h                  # 1m | 5m | 15m | 1h | 4h | 1d
SIGNAL_INTERVAL_MINUTES=240   # how often to run full analysis cycle

# ── Risk Parameters ────────────────────────
ACCOUNT_SIZE=10000            # paper account size in USD
MAX_RISK_PER_TRADE=0.02       # 2% max risk per trade
MAX_PORTFOLIO_HEAT=0.06       # 6% max total open risk
KELLY_FRACTION=0.25           # fractional kelly (0.25 = quarter-kelly)
MIN_AGENT_AGREEMENT=6         # minimum agents that must agree (out of 8)
MIN_AVG_CONFIDENCE=75         # minimum average confidence score

# ── Dashboard ──────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Bamboo API (Nigerian Stocks) ────────
BAMBOO_API_KEY=...
BAMBOO_USERNAME=...
BAMBOO_PASSWORD=...
BAMBOO_USER_ID=...
BAMBOO_CSCS=...
BAMBOO_CHN=...

