# Gitignore for AIOS root workspace optimization
.DS_Store
AIS-OS/
Scrapegraph-ai/
/autoresearch/
graphify-out/
markitdown/
rtk/
.agents/
.playwright-mcp/

# Python & virtualenv
trading_engine/venv/
trading_engine/**/__pycache__/
trading_engine/**/*.pyc
trading_engine/.pytest_cache/

# Trading engine runtime/data outputs
trading_engine/backtest_results/
# trading_engine/storage/
trading_engine/live_state.json
trading_engine/paper_state.json
trading_engine/.env
/data/

# Polymarket / Bybit bot ignores
polymarket_bot/.env
polymarket_bot/paper_state.json
polymarket_bot/paper_state.lock
polymarket_bot/**/__pycache__/
polymarket_bot/**/*.pyc
polymarket_bot/.pytest_cache/
polymarket_bot/best_params.json
polymarket_bot/autoresearch_history.json
polymarket_bot/tests/__pycache__/

